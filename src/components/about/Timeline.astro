---
import { getSkillName } from "../../data/content";

interface TimelineEntry {
	title: string;
	period: string;
	organization?: string;
	skills: readonly string[];
	Content: any;
}

interface Props {
	entries: readonly TimelineEntry[];
}

const { entries } = Astro.props;
---

<div class="mt-6 space-y-6 border-l border-slate-300 pl-6">
	{entries.map(({ title, period, organization, skills, Content }) => (
		<article class="relative">
			<span class="absolute -left-[1.9rem] top-1.5 size-2 rounded-full bg-slate-900" aria-hidden="true"></span>
			<p class="text-sm text-slate-500">{period}</p>
			<h3 class="mt-1 text-lg font-semibold text-slate-900">{title}</h3>
			{organization && <p class="mt-1 text-sm text-slate-600">{organization}</p>}
			<div class="mt-3 leading-7 text-slate-600"><Content /></div>
			{skills.length > 0 && (
				<ul class="mt-3 flex flex-wrap gap-2" aria-label={`${title}の関連スキル`}>
					{skills.map((skill) => (
						<li class="rounded bg-slate-100 px-2 py-1 text-xs text-slate-700">{getSkillName(skill)}</li>
					))}
				</ul>
			)}
		</article>
	))}
</div>
