---
import { getCollection, render } from "astro:content";

import SectionTitle from "../components/common/SectionTitle.astro";
import SkillList from "../components/about/SkillList.astro";
import Timeline from "../components/about/Timeline.astro";
import { formatPeriod } from "../data/content";
import { profile } from "../data/profile";
import { skills } from "../data/skills";
import Layout from "../layouts/Layout.astro";

const experiences = (await getCollection("experiences")).sort(
	(a, b) => b.data.start.getTime() - a.data.start.getTime(),
);

const experienceEntries = await Promise.all(
	experiences.map(async (experience) => ({
		experience,
		Content: (await render(experience)).Content,
	})),
);

const timelineEntries = experienceEntries.map(({ experience, Content }) => ({
	title: experience.data.title,
	period: formatPeriod(experience.data.start, experience.data.end),
	organization: experience.data.organization,
	skills: experience.data.skills,
	Content,
}));
---

<Layout title={`About | ${profile.name}`} description={profile.description}>
	<main class="mx-auto max-w-4xl px-6 py-12">
		<header class="py-16">
			<SectionTitle as="h1" eyebrow="About" title={profile.name} />
			<p class="mt-4 text-xl text-slate-600">{profile.role}</p>
			<p class="mt-6 max-w-2xl leading-8 text-slate-600">{profile.description}</p>
		</header>

		<section aria-labelledby="experience-title">
			<SectionTitle id="experience-title" title="Experience" />
			<Timeline entries={timelineEntries} />
		</section>

		<section class="mt-16" aria-labelledby="skills-title">
			<SectionTitle id="skills-title" title="Skills" />
			<SkillList skills={skills} />
		</section>
	</main>
</Layout>
