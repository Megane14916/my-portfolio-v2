---
import { getCollection } from "astro:content";

import { profile } from "../data/profile";
import { skills } from "../data/skills";
import Layout from "../layouts/Layout.astro";

const experiences = (await getCollection("experiences")).sort(
	(a, b) => b.data.start.getTime() - a.data.start.getTime(),
);

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat("ja-JP", {
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	}).format(date);
---

<Layout title={`About | ${profile.name}`} description={profile.description}>
	<main class="mx-auto max-w-4xl px-6 py-12">
		<nav class="border-b border-slate-200 pb-6 text-sm text-slate-600" aria-label="パンくず">
			<a class="hover:text-slate-900" href="/">Home</a>
			<span class="mx-2">/</span>
			<span>About</span>
		</nav>

		<header class="py-16">
			<p class="text-sm font-medium uppercase tracking-widest text-slate-500">About</p>
			<h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900">{profile.name}</h1>
			<p class="mt-4 text-xl text-slate-600">{profile.role}</p>
			<p class="mt-6 max-w-2xl leading-8 text-slate-600">{profile.description}</p>
		</header>

		<section aria-labelledby="experience-title">
			<h2 id="experience-title" class="text-2xl font-semibold text-slate-900">Experience</h2>
			<div class="mt-6 space-y-6 border-l border-slate-300 pl-6">
				{experiences.map((experience) => (
					<article class="relative">
						<span class="absolute -left-[1.9rem] top-1.5 size-2 rounded-full bg-slate-900" aria-hidden="true"></span>
						<p class="text-sm text-slate-500">
							{formatDate(experience.data.start)}
							{experience.data.end ? ` – ${formatDate(experience.data.end)}` : " – 現在"}
						</p>
						<h3 class="mt-1 text-lg font-semibold text-slate-900">{experience.data.title}</h3>
						{experience.data.organization && <p class="mt-1 text-sm text-slate-600">{experience.data.organization}</p>}
					</article>
				))}
			</div>
		</section>

		<section class="mt-16" aria-labelledby="skills-title">
			<h2 id="skills-title" class="text-2xl font-semibold text-slate-900">Skills</h2>
			<ul class="mt-6 grid gap-3 sm:grid-cols-2">
				{skills.map((skill) => (
					<li class="rounded border border-slate-200 px-4 py-3">
						<span class="font-medium text-slate-900">{skill.name}</span>
						<span class="ml-2 text-sm text-slate-500">{skill.category}</span>
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>
