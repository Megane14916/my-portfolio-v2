---
import { getCollection } from "astro:content";

import { formatPeriod, getSkillName } from "../../data/content";
import Layout from "../../layouts/Layout.astro";

const works = (await getCollection("works")).sort(
	(a, b) => b.data.start.getTime() - a.data.start.getTime(),
);

---

<Layout title="Works | My Portfolio" description="制作物一覧">
	<main class="mx-auto max-w-5xl px-6 py-12">
		<nav class="border-b border-slate-200 pb-6 text-sm text-slate-600" aria-label="パンくず">
			<a class="hover:text-slate-900" href="/">Home</a>
			<span class="mx-2">/</span>
			<span>Works</span>
		</nav>

		<header class="py-16">
			<p class="text-sm font-medium uppercase tracking-widest text-slate-500">Works</p>
			<h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900">制作物</h1>
			<p class="mt-4 text-slate-600">これまでに取り組んだ制作物を紹介します。</p>
		</header>

		<section class="grid gap-5 md:grid-cols-2" aria-label="制作物一覧">
			{works.map((work) => (
				<article class="rounded-lg border border-slate-200 p-6">
					{work.data.featured && <p class="text-xs font-medium uppercase tracking-widest text-slate-500">Featured</p>}
					<h2 class="mt-2 text-xl font-semibold text-slate-900">{work.data.title}</h2>
					<p class="mt-3 leading-7 text-slate-600">{work.data.description}</p>
					<p class="mt-4 text-sm text-slate-500">{formatPeriod(work.data.start, work.data.end)}</p>
					<ul class="mt-4 flex flex-wrap gap-2" aria-label={`${work.data.title}の使用技術`}>
						{work.data.skills.map((skill) => (
							<li class="rounded bg-slate-100 px-2 py-1 text-xs text-slate-700">{getSkillName(skill)}</li>
						))}
					</ul>
					<a class="mt-6 inline-block text-sm font-medium text-slate-900 underline underline-offset-4" href={`/works/${work.data.slug}`}>
						詳しく見る
					</a>
				</article>
			))}
		</section>
	</main>
</Layout>
