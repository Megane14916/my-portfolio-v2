---
import { getCollection } from "astro:content";

import SectionTitle from "../../components/common/SectionTitle.astro";
import WorkList from "../../components/works/WorkList.astro";
import Layout from "../../layouts/Layout.astro";

const works = (await getCollection("works")).sort(
	(a, b) => b.data.start.getTime() - a.data.start.getTime(),
);

---

<Layout title="Works | My Portfolio" description="制作物一覧">
	<main class="mx-auto max-w-5xl px-6 py-12">
		<header class="py-16">
			<SectionTitle as="h1" eyebrow="Works" title="制作物" description="これまでに取り組んだ制作物を紹介します。" />
		</header>

		<WorkList works={works} />
	</main>
</Layout>
