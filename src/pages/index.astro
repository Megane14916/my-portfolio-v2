---
import { getCollection } from "astro:content";

import SectionTitle from "../components/common/SectionTitle.astro";
import WorkList from "../components/works/WorkList.astro";
import { profile } from "../data/profile";
import Layout from "../layouts/Layout.astro";

const works = await getCollection("works");
const featuredWorks = works
	.filter((work) => work.data.featured)
	.sort((a, b) => b.data.start.getTime() - a.data.start.getTime())
	.slice(0, 3);
---

<Layout title={profile.name} description={profile.introduction}>
	<main class="mx-auto max-w-5xl px-6 py-12">
		<section class="py-24">
			<p class="text-sm font-medium uppercase tracking-widest text-slate-500">Portfolio</p>
			<h1 class="mt-4 text-5xl font-bold tracking-tight text-slate-900">{profile.name}</h1>
			<p class="mt-4 text-xl text-slate-600">{profile.role}</p>
			<p class="mt-6 max-w-2xl leading-8 text-slate-600">{profile.description}</p>
			<div class="mt-8 flex gap-4">
				<a class="rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" href="/about">
					Aboutを見る
				</a>
				<a class="rounded border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-500" href="/works">
					Worksを見る
				</a>
			</div>
		</section>

		<section aria-labelledby="featured-works-title">
			<div class="flex items-end justify-between gap-4">
				<SectionTitle id="featured-works-title" title="Featured Works" />
				<a class="text-sm text-slate-600 hover:text-slate-900" href="/works">すべて見る</a>
			</div>
			<div class="mt-6"><WorkList works={featuredWorks} /></div>
		</section>
	</main>
</Layout>
